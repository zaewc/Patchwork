{
  "name": "patchwork",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "npm run typecheck && npm run lint && npm run lint:arch",
    "format": "prettier --write .",
    "format:staged": "lint-staged",
    "lint": "eslint",
    "lint:arch": "steiger ./src",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:performance": "node e2e/performance/build.mjs && lhci autorun",
    "test:all": "npm run check && npm run test:coverage && npm run test:e2e",
    "typecheck": "next typegen && tsc --noEmit",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-country-flag": "^3.1.0",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "eslint-plugin-check-file": "^3.3.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "react-doctor": "^0.9.12",
    "steiger": "^0.6.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
